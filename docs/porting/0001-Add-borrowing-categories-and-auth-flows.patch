+import { PERMISSIONS } from '../../constants/permissions';
+import type { ExportColumn } from '../../utils/export';
+
+function today() {
+  return todayInAppTimezone();
+}
+
+const emptyForm = {
+  storeId: '',
+  lender: '',
+  note: '',
