+  const [updateCategory, { isLoading: updating }] = useUpdateSaleCategoryMutation();
+  const [bulkDeleteCategories, { isLoading: deleting }] = useBulkDeleteSaleCategoriesMutation();
+  const [open, setOpen] = useState(false);
