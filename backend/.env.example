NODE_ENV=development
PORT=5000
APP_NAME=Louisiana Hot Chicken Admin API
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb://127.0.0.1:27017/louisiana_hot_chicken

JWT_ACCESS_SECRET=change_this_access_secret_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_refresh_secret_to_a_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

SUPER_ADMIN_NAME=Platform Super Admin
SUPER_ADMIN_EMAIL=admin@louisianahotchicken.com
SUPER_ADMIN_PASSWORD=ChangeMeNow!123

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_DRIVER=local

SEED_DEMO_DATA=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000
